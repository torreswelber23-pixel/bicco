# Copie para .env.local e preencha. Nada aqui vai para o git.

# --- Meta / WhatsApp Cloud API -------------------------------------------
# Token do System User com a permissão whatsapp_business_messaging.
WHATSAPP_TOKEN=
# ID do número (Phone Number ID) — não é o telefone.
WHATSAPP_PHONE_NUMBER_ID=
# ID da conta comercial, usado só pelos scripts de criação do Flow.
WHATSAPP_BUSINESS_ACCOUNT_ID=
# App Secret do app na Meta: valida a assinatura X-Hub-Signature-256.
WHATSAPP_APP_SECRET=
# String que você inventa e repete no painel ao cadastrar o webhook.
WHATSAPP_VERIFY_TOKEN=
# ID do Flow (saída de scripts/publish-flow.mjs --create).
WHATSAPP_FLOW_ID=
GRAPH_API_VERSION=v21.0
# Deixe "draft" enquanto o Flow não estiver publicado; remova depois.
# FLOW_MODE=draft

# --- Endpoint de dados do Flow -------------------------------------------
# Chave privada RSA em uma linha, com \n literais (saída de npm run keys:generate).
FLOW_PRIVATE_KEY=
FLOW_PRIVATE_KEY_PASSPHRASE=

# --- Supabase -------------------------------------------------------------
SUPABASE_URL=
# Service role: ignora RLS. Só no servidor, nunca no cliente.
SUPABASE_SERVICE_ROLE_KEY=

# --- Painel ---------------------------------------------------------------
ADMIN_PASSWORD=

# --- Só para scripts/simulate-flow.mjs -----------------------------------
# FLOW_ENDPOINT_URL=http://localhost:3000/api/whatsapp/flow
