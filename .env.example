# Copie para .env.local e preencha. Nada aqui vai para o git.

# --- Meta / WhatsApp Cloud API -------------------------------------------
# App Secret do app na Meta. Usado em duas coisas: validar a assinatura
# X-Hub-Signature-256 e assinar a troca de tokens no OAuth.
WHATSAPP_APP_SECRET=
# ID do app na Meta. Não é segredo — aparece na URL de autorização.
META_APP_ID=
# String que você inventa e repete no painel ao cadastrar o webhook.
WHATSAPP_VERIFY_TOKEN=
# ID do Flow (saída de scripts/publish-flow.mjs --create).
WHATSAPP_FLOW_ID=
GRAPH_API_VERSION=v21.0
# Deixe "draft" enquanto o Flow não estiver publicado; remova depois.
# FLOW_MODE=draft

# --- Token e número: OAuth ou manual -------------------------------------
# O CAMINHO RECOMENDADO é conectar pelo painel /admin: o token e o número
# são descobertos e guardados no banco automaticamente, e renovados por cron.
#
# As duas variáveis abaixo são apenas o fallback manual, usado enquanto
# nenhuma conta estiver conectada. Depois de conectar pelo painel, elas
# passam a ser ignoradas — o banco tem precedência.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Usado só pelos scripts de criação do Flow.
WHATSAPP_BUSINESS_ACCOUNT_ID=

# --- Endpoint de dados do Flow -------------------------------------------
# Chave privada RSA. Aceita três formatos: PEM multi-linha, PEM em uma linha
# com \n literais, ou o PEM inteiro em base64 (o mais à prova de colagem).
FLOW_PRIVATE_KEY=
FLOW_PRIVATE_KEY_PASSPHRASE=

# --- Cron -----------------------------------------------------------------
# Protege /api/cron/*. Sem isso, qualquer um que descubra a URL consegue
# rotacionar a credencial de produção. Gere um valor aleatório longo.
CRON_SECRET=

# --- Supabase -------------------------------------------------------------
SUPABASE_URL=
# Service role: ignora RLS. Só no servidor, nunca no cliente.
SUPABASE_SERVICE_ROLE_KEY=

# --- Painel ---------------------------------------------------------------
ADMIN_PASSWORD=

# --- Só para scripts/simulate-flow.mjs -----------------------------------
# FLOW_ENDPOINT_URL=http://localhost:3000/api/whatsapp/flow
