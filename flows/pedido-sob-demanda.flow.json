{
  "version": "7.1",
  "data_api_version": "3.0",
  "routing_model": {
    "SERVICO": ["CORRIDA", "ENTREGA"],
    "CORRIDA": ["AGENDAMENTO", "RESUMO"],
    "ENTREGA": ["AGENDAMENTO", "RESUMO"],
    "AGENDAMENTO": ["RESUMO"],
    "RESUMO": []
  },
  "screens": [
    {
      "id": "SERVICO",
      "title": "O que você precisa?",
      "data": {
        "servicos": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "description": { "type": "string" }
            }
          },
          "__example__": [
            { "id": "corrida", "title": "Corrida", "description": "Pedir uma corrida" },
            { "id": "entrega", "title": "Entrega", "description": "Buscar e entregar algo" }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Pedir corrida ou entrega"
          },
          {
            "type": "Form",
            "name": "form_servico",
            "children": [
              {
                "type": "TextInput",
                "name": "nome",
                "label": "Seu nome",
                "input-type": "text",
                "required": true
              },
              {
                "type": "RadioButtonsGroup",
                "name": "tipo_servico",
                "label": "Tipo de pedido",
                "required": true,
                "data-source": "${data.servicos}"
              },
              {
                "type": "Footer",
                "label": "Continuar",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "screen": "SERVICO",
                    "nome": "${form.nome}",
                    "tipo_servico": "${form.tipo_servico}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "CORRIDA",
      "title": "Detalhes da corrida",
      "data": {
        "quandos": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" }
            }
          },
          "__example__": [{ "id": "agora", "title": "Agora" }]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "form_corrida",
            "children": [
              {
                "type": "TextInput",
                "name": "origem",
                "label": "Endereço de partida",
                "input-type": "text",
                "required": true
              },
              {
                "type": "TextInput",
                "name": "destino",
                "label": "Endereço de destino",
                "input-type": "text",
                "required": true
              },
              {
                "type": "RadioButtonsGroup",
                "name": "quando",
                "label": "Quando?",
                "required": true,
                "data-source": "${data.quandos}"
              },
              {
                "type": "Footer",
                "label": "Continuar",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "screen": "CORRIDA",
                    "origem": "${form.origem}",
                    "destino": "${form.destino}",
                    "quando": "${form.quando}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "ENTREGA",
      "title": "Detalhes da entrega",
      "data": {
        "quandos": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" }
            }
          },
          "__example__": [{ "id": "agora", "title": "Agora" }]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "form_entrega",
            "children": [
              {
                "type": "TextInput",
                "name": "endereco_coleta",
                "label": "Endereço de coleta",
                "input-type": "text",
                "required": true
              },
              {
                "type": "TextInput",
                "name": "endereco_entrega",
                "label": "Endereço de entrega",
                "input-type": "text",
                "required": true
              },
              {
                "type": "TextArea",
                "name": "item_descricao",
                "label": "O que vai ser entregue?",
                "required": true,
                "max-length": 300
              },
              {
                "type": "TextInput",
                "name": "destinatario_nome",
                "label": "Nome de quem vai receber",
                "input-type": "text",
                "required": false
              },
              {
                "type": "TextInput",
                "name": "destinatario_telefone",
                "label": "Telefone de quem vai receber",
                "input-type": "phone",
                "required": false
              },
              {
                "type": "RadioButtonsGroup",
                "name": "quando",
                "label": "Quando?",
                "required": true,
                "data-source": "${data.quandos}"
              },
              {
                "type": "Footer",
                "label": "Continuar",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "screen": "ENTREGA",
                    "endereco_coleta": "${form.endereco_coleta}",
                    "endereco_entrega": "${form.endereco_entrega}",
                    "item_descricao": "${form.item_descricao}",
                    "destinatario_nome": "${form.destinatario_nome}",
                    "destinatario_telefone": "${form.destinatario_telefone}",
                    "quando": "${form.quando}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "AGENDAMENTO",
      "title": "Melhor horário",
      "data": {
        "datas": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" }
            }
          },
          "__example__": [{ "id": "2026-08-05", "title": "Qua, 05/08" }]
        },
        "horarios": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "enabled": { "type": "boolean" }
            }
          },
          "__example__": [
            { "id": "09:00", "title": "09:00", "enabled": true },
            { "id": "10:00", "title": "10:00", "enabled": false }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextBody",
            "text": "Escolha quando prefere ser atendido."
          },
          {
            "type": "Form",
            "name": "form_agenda",
            "children": [
              {
                "type": "Dropdown",
                "name": "data_preferida",
                "label": "Dia",
                "required": true,
                "data-source": "${data.datas}",
                "on-select-action": {
                  "name": "data_exchange",
                  "payload": {
                    "screen": "AGENDAMENTO_SLOTS",
                    "data_preferida": "${form.data_preferida}"
                  }
                }
              },
              {
                "type": "RadioButtonsGroup",
                "name": "horario_preferido",
                "label": "Horário",
                "required": true,
                "data-source": "${data.horarios}"
              },
              {
                "type": "Footer",
                "label": "Enviar pedido",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "screen": "AGENDAMENTO",
                    "data_preferida": "${form.data_preferida}",
                    "horario_preferido": "${form.horario_preferido}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "RESUMO",
      "title": "Pedido registrado",
      "terminal": true,
      "success": true,
      "data": {
        "protocolo": { "type": "string", "__example__": "BIC-4F2A9C" },
        "resumo": {
          "type": "string",
          "__example__": "De: Rua A, 100\nPara: Rua B, 200"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "Buscando alguém pra te atender" },
          {
            "type": "TextBody",
            "text": "Protocolo ${data.protocolo}"
          },
          { "type": "TextCaption", "text": "${data.resumo}" },
          {
            "type": "TextBody",
            "text": "Assim que um motorista ou entregador aceitar, avisamos por aqui."
          },
          {
            "type": "Footer",
            "label": "Concluir",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "protocolo": "${data.protocolo}",
                "resumo": "${data.resumo}"
              }
            }
          }
        ]
      }
    }
  ]
}
